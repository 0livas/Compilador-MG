bora_cumpade main()
simbora
    trem_di_numeru x, y uai
    trem_cum_virgula z uai

    x fica_assim_entao 1 uai
    y fica_assim_entao 2 uai
    z fica_assim_entao 1.5 uai

    roda_esse_trem (x fica_assim_entao 0; x < 3; x fica_assim_entao x + 1) simbora
        uai_se (x mema_coisa 1) simbora
            oia_proce_ve("meio\n") uai
        cabo
        uai_senao simbora
            oia_proce_ve(x, "\n") uai
        cabo
    cabo

    enquanto_tiver_trem (y < 5) simbora
        y fica_assim_entao y + 1 uai
    cabo

    dependenu (y) simbora
        du_casu 5:
            oia_proce_ve("cinco\n") uai
        uai_so:
            oia_proce_ve("outro\n") uai
    cabo

    ta_bao 0 uai
cabo
